<launch>
  <!-- 1. Gazebo + UR3 -->
  <arg name="paused" default="true"/>
  <include file="$(find ur_gazebo)/launch/ur3_bringup.launch">
    <arg name="paused" value="$(arg paused)"/>
  </include>

  <!-- 2. MoveIt! -->
  <include file="$(find ur3_moveit_config)/launch/moveit_planning_execution.launch">
    <arg name="sim" value="true"/>
  </include>

  <!-- 3. RViz -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find bprrt)/rviz/ur3_planning_config.rviz" required="true"/>

  <!-- 4. BP‑RRT* node -->
  <node name="bprrt_node" pkg="bprrt" type="bprrt_node" output="screen">
    <!-- load your params -->
    <rosparam file="$(find bprrt)/config/bp_rrt_params.yaml" command="load" />
  </node>
</launch>
