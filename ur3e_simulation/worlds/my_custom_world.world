<?xml version="1.0"?>
<sdf version="1.6">
  <world name="my_custom_world">
    
    <!-- Load Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Load Light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- item 1: cube_b at half size -->
    <include>
      <uri>model://cube_b</uri>
      <pose>-0.2 0.4 0.8 0 0 0</pose>
      <scale>0.5 0.5 0.5</scale>
    </include>

    <!-- item 2: cylinder_bg at half size -->
    <include>
      <uri>model://cylinder_bg</uri>
      <pose>0.3 0.4 0.8 0 0 0</pose>
      <scale>0.5 0.5 0.5</scale>
    </include>

    <!--wall -->
    <include>
      <uri>model://Workshop</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Black box at the origin, 0.128 × 0.128 × 0.5 m (base at z=0) -->
    <model name="grey_box">
      <static>true</static>
      <link name="box_link">
        <!-- center of box is at z=0.25, so its bottom sits on z=0 -->
        <pose>0 -0.22 0.4 0 0 0</pose>
        <collision name="box_collision">
          <geometry>
            <box>
              <size>2.0 1.5 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="box_visual">
          <geometry>
            <box>
              <size>2.0 1.5 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.7 0.5 1</ambient>
            <diffuse>0.8 0.7 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
