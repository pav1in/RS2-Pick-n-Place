<?xml version="1.0"?>
<sdf version="1.6">
  <world name="my_custom_world">
    
    <!-- Load Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Load Light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Load table -->
    <include>
      <uri>model://table</uri>
      <pose>0 0.46 0.0 0 0 0</pose>
    </include>

    <!--item 1 on top of table -->
    <include>
      <uri>model://cricket_ball</uri>
      <pose>-0.4 0.6 1 0 0 0</pose>
    </include>

      <!--item 2 on top of table -->
    <include>
      <uri>model://wood_cube_5cm</uri>
      <pose>-0.2 0.6 1 0 0 0</pose>
    </include>

     <!--item 3 on top of table -->
    <include>
      <uri>model://wood_cube_10cm</uri>
      <pose>0.2 0.6 1 0 0 0</pose>
    </include>

    <!--item 4 on top of table -->
    <include>
      <uri>model://coke_can</uri>
      <pose>0.5 0.6 1 0 0 0</pose>
    </include>

    <!-- background -->
    <include>
      <uri>model://cafe</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Load plane 
    <include>
      <uri>model://asphalt_plane</uri>
      <pose>0 0.0 0.0 0 0 0</pose>
    </include>
    -->

    <!-- Load depth camera 
    <include>
      <uri>model://depth_camera</uri>
      <pose>0 0 1.5 0 0 0</pose>
    </include> -->

    <!-- Add a box (platform) at the origin -->
    <model name="robot_platform">
      <static>true</static>
      <link name="platform_link">
        <!-- Pose: center at (0,0,0.25). With height 0.5, its top is at z=0.5 -->
        <pose>0 -0.45 0.55 0 0 0</pose>
        <collision name="platform_collision">
          <geometry>
            <box>
              <size>2 1 1.0</size>  <!-- Width, Depth, Height -->
            </box>
          </geometry>
        </collision>
        <visual name="platform_visual">
          <geometry>
            <box>
              <size>2.0 1.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    

  </world>
</sdf>
